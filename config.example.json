{
  "keywords": [
    "deepfake",
    "fake image",
    "forgery detection",
    "image manipulation detection",
    "tampering localization",
    "audio deepfake",
    "video forgery",
    "media forensics"
  ],
  "keyword_mode": "any",
  "download_dir": "downloads",
